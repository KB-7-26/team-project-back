SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/kb_project?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=0000
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# Local development: use a service account JSON file that is outside this repo.
FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/firebase-service-account.json

# Production/GitHub Secrets: use raw one-line JSON or base64-encoded JSON instead of a file path.
FIREBASE_SERVICE_ACCOUNT_JSON=

IMAGE_UPLOAD_DIR=./uploads
IMAGE_BASE_URL=http://localhost:8080

APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
